NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/solvhub?schema=public"

# Long random string (at least 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

SEED_ADMIN_NAME="SOLVHub Administrator"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
# Verification document storage (folder on this server) and max file size in MB
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
